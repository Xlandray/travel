# Copy to .env.prod on the host machine and replace every placeholder.
# Never commit the filled-in file.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=armonitex
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=armonitex

# At least 32 characters. Changing it invalidates every existing session and
# every password reset link that has been emailed but not yet used.
JWT_SECRET_KEY=replace-with-a-unique-random-jwt-secret-of-at-least-32-characters

# Every origin that may call the API from a browser, as a JSON list. The Vercel
# site and the admin panel both need to be here, with their exact scheme and
# host. A missing entry looks like a broken site with CORS errors in the console.
CORS_ALLOWED_ORIGINS=["https://travelturkey.vercel.app","https://admin.example.com"]

# Baked into the admin panel bundle at build time. Must be the public API URL,
# not an internal one, because it is the browser that calls it.
ADMIN_API_URL=https://api.example.com/api/v1

# From the Cloudflare dashboard: Zero Trust -> Networks -> Tunnels -> your
# tunnel -> Install and run a connector. Copy the token out of the command.
# This is a credential; treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-tunnel-token

# Leave SMTP_PASSWORD at this exact sentinel to keep the app logging emails
# instead of sending them. Any other value makes it attempt a real connection.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me-in-production
